# one-voice example environment — copy this file to `.env` and adjust.
# NOTE: one-voice reads these variables from the process environment via
# os.environ; it does NOT auto-load a `.env` file. Either export the values
# in your shell profile, or source the file before running, e.g.:
#   set -a; source .env; set +a
# `.env` is git-ignored (never commit real local configuration);
# `.env.example` is the checked-in template for the variables one-voice reads.

# ---------------------------------------------------------------------------
# Voice resolution
# ---------------------------------------------------------------------------
# Default voice name used when a script line has no [voice: ...] tag.
# Resolution order for a line's voice:
#   1. explicit [voice: NAME] tag in the script
#   2. ONE_VOICE environment variable
#   3. first available voice alphabetically (fallback)
# Available in this repo: golding, neufeld
# ONE_VOICE=golding

# Voice-profile search path — colon-separated list of directories containing
# voice profiles (each a folder with a voice.yaml + reference audio).
# Leftmost entry wins when two profiles share a name.
# If unset, the bundled voices/ directory inside the repo/package is used.
# ONE_VOICE_PATH=/absolute/path/to/voices_a:/absolute/path/to/voices_b

# Alternative to ONE_VOICE_PATH: a single directory to use as THE voices
# directory (searches it instead of the bundled voices/). If both are set,
# ONE_VOICE_PATH takes precedence.
# ONE_VOICE_DIR=/absolute/path/to/voices